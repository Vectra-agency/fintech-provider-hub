{
  "name": "fintech-provider-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "pnpm check:placeholders && next build",
    "start": "npx --yes serve@14 out -l 3000",
    "preview:cf": "wrangler pages dev out --port 8788",
    "typecheck": "tsc --noEmit && tsc -p functions --noEmit",
    "lint": "eslint .",
    "check:headings": "tsx scripts/check-headings.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "extract:reference": "tsx scripts/extract-reference.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "prepare:hero": "tsx scripts/prepare-hero-media.ts",
    "check:js-budget": "tsx scripts/check-js-budget.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
